{
	"name": "efinanceira",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"start": "bun src/server.ts",
		"dev": "bun --watch src/server.ts",
		"lint": "bunx --bun biome check --write",
		"swagger:build": "cd node_modules/@elysiajs/swagger && bun install && bun run build || true && rm -rf node_modules && cd ../../..",
		"prepare": "husky"
	},
	"dependencies": {
		"@discordjs/voice": "^0.18.0",
		"@elysiajs/cors": "^1.3.3",
		"@elysiajs/swagger": "github:gsbenevides2/elysia-swagger",
		"@grotto/logysia": "^0.1.6",
		"discord.js": "^14.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@commitlint/config-conventional": "^19.8.1",
		"bun-types": "latest",
		"husky": "^9.1.7"
	}
}
